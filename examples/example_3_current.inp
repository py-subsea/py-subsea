<py
    ####################################################################
    ## Import Main Python Modules                                     ##
    ####################################################################
    import pandas as pd
    import numpy as np

    ####################################################################
    ## Import Input Data                                              ##
    ####################################################################
    pipe_df = pd.read_excel('example_3.xlsx', sheet_name = 'Linepipe')
    pipe_df = pipe_df.transpose()
    pipe_df.columns = pipe_df.loc['Property']

    inputs = pipe_df.iloc[-1].squeeze()
    inputs['orad'] = inputs['od'] / 2.0
py>
